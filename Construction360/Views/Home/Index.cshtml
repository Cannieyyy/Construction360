@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<div class="hero" style="min-height:100vh;">
    <nav class="navbar-public">
        <div style="display:flex;align-items:center;gap:10px;">
            <div class="brand-icon" style="background:#1a2942;">🏗</div>
            <span style="font-weight:800;font-size:16px;color:#1a2942;">Construct360</span>
            <span style="font-size:12px;color:#6b7280;margin-left:4px;">by ROCLA</span>
        </div>
        <div class="nav-links">
            <a href="#">Features</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </div>
        <div class="nav-ctas">
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Get Started</a>
        </div>
    </nav>
    <div class="hero-body">
        <div class="hero-badge">🏗 Enterprise Workforce Management</div>
        <h1 class="hero-title">
            Build Stronger Teams with<br>
            <span>Construct360</span>
        </h1>
        <p class="hero-subtitle">
            The complete workforce management platform for ROCLA. Track attendance,
            manage employees, monitor productivity, and streamline operations with our
            industrial-grade solution.
        </p>
        <div style="margin-top:40px;display:flex;gap:16px;justify-content:center;">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary" style="padding:14px 32px;font-size:15px;">Get Started Free</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline" style="padding:14px 32px;font-size:15px;">Sign In</a>
        </div>
    </div>
</div>
