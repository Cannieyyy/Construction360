@model Construction360.ViewModels.SupervisorDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Supervisor Dashboard";
    Layout = "_AppLayout";
}

<!-- Quick Action Banner -->
<div class="quick-action">
    <div>
        <strong style="font-size:15px;">Quick Attendance Scanner</strong>
        <p>Scan employee QR codes to record attendance instantly</p>
    </div>
    <a href="/Supervisor/QRScanner" class="btn btn-primary">
        <i class="fa-solid fa-qrcode"></i> Open Scanner
    </a>
</div>

<!-- Stats Grid -->
<div class="stat-grid">
    <div class="stat-card" style="border-left: 4px solid #1a2942;">
        <div>
            <div class="stat-label">Team Size</div>
            <div class="stat-value">@Model.TeamSize</div>
            <div class="stat-sub">Active members</div>
        </div>
        <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
    </div>
    
    <div class="stat-card" style="border-left: 4px solid #059669;">
        <div>
            <div class="stat-label">Present Today</div>
            <div class="stat-value">@Model.PresentToday</div>
            <div class="stat-sub">
                <i class="fa-solid fa-arrow-up"></i> 
                @(Model.TeamSize > 0 ? Math.Round((double)Model.PresentToday / Model.TeamSize * 100, 1) : 0)% attendance
            </div>
        </div>
        <div class="stat-icon" style="background:#d1fae5;">
            <i class="fa-solid fa-user-check"></i>
        </div>
    </div>
    
    <div class="stat-card" style="border-left: 4px solid #d97706;">
        <div>
            <div class="stat-label">Pending Approvals</div>
            <div class="stat-value">@Model.PendingApprovals</div>
            <div class="stat-sub warn">
                <i class="fa-solid fa-clock"></i> Awaiting review
            </div>
        </div>
        <div class="stat-icon" style="background:#fef3c7;">
            <i class="fa-solid fa-clipboard-check"></i>
        </div>
    </div>
    
    <div class="stat-card" style="border-left: 4px solid #7c3aed;">
        <div>
            <div class="stat-label">Team Productivity</div>
            <div class="stat-value">@Model.TeamProductivity%</div>
            <div class="stat-sub @(Model.ProductivityChange >= 0 ? "" : "warn")">
                <i class="fa-solid fa-arrow-@(Model.ProductivityChange >= 0 ? "up" : "down")"></i>
                @Math.Abs(Model.ProductivityChange)% vs last week
            </div>
        </div>
        <div class="stat-icon" style="background:#ede9fe;">
            <i class="fa-solid fa-chart-line"></i>
        </div>
    </div>
</div>

<!-- Additional Stats Row -->
<div class="stat-grid" style="grid-template-columns: repeat(4, 1fr);">
    <div class="stat-card">
        <div>
            <div class="stat-label">Absent Today</div>
            <div class="stat-value" style="color:#dc2626;">@Model.AbsentToday</div>
        </div>
        <div class="stat-icon" style="background:#fee2e2;">
            <i class="fa-solid fa-user-xmark"></i>
        </div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Late Today</div>
            <div class="stat-value" style="color:#d97706;">@Model.LateToday</div>
        </div>
        <div class="stat-icon" style="background:#fef3c7;">
            <i class="fa-solid fa-clock"></i>
        </div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">On Leave</div>
            <div class="stat-value" style="color:#6b7280;">@Model.OnLeaveToday</div>
        </div>
        <div class="stat-icon">
            <i class="fa-solid fa-calendar-check"></i>
        </div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Top Performer</div>
            <div class="stat-value" style="font-size:20px;">@Model.TopPerformer</div>
        </div>
        <div class="stat-icon" style="background:#fef3c7;">
            <i class="fa-solid fa-trophy" style="color:#d97706;"></i>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="charts-row">
    <div class="chart-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 style="margin:0;">Team Attendance This Week</h3>
            <span style="font-size:12px;color:#6b7280;">
                <i class="fa-regular fa-calendar"></i> @DateTime.Now.ToString("MMM dd, yyyy")
            </span>
        </div>
        <canvas id="attendChart" width="420" height="220"></canvas>
        <div style="display:flex;gap:20px;margin-top:14px;justify-content:center;font-size:12px;">
            <span style="display:flex;align-items:center;gap:6px;">
                <span style="width:14px;height:14px;background:#1a2942;border-radius:3px;display:inline-block;"></span>
                Present
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
                <span style="width:14px;height:14px;background:#c0392b;border-radius:3px;display:inline-block;"></span>
                Absent
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
                <span style="width:14px;height:14px;background:#d4a847;border-radius:3px;display:inline-block;"></span>
                Late
            </span>
        </div>
    </div>

    <div class="chart-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 style="margin:0;">Productivity Trend</h3>
            <span style="font-size:12px;color:#6b7280;">
                <i class="fa-regular fa-clock"></i> Last 4 weeks
            </span>
        </div>
        <canvas id="prodChart" width="420" height="220"></canvas>
        <div style="display:flex;gap:20px;margin-top:14px;justify-content:center;font-size:12px;">
            <span style="display:flex;align-items:center;gap:6px;">
                <span style="width:20px;height:3px;background:#9ca3af;border-radius:2px;display:inline-block;border:1px dashed #9ca3af;"></span>
                Target (90%)
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
                <span style="width:20px;height:3px;background:#1a2942;border-radius:2px;display:inline-block;"></span>
                Actual
            </span>
        </div>
    </div>
</div>

<!-- Recent Leave Requests & Attendance -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px;">
    <!-- Recent Leave Requests -->
    <div class="card">
        <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
            <strong style="font-size:15px;">Pending Leave Requests</strong>
            @if (Model.PendingApprovals > 0)
            {
                <span class="badge badge-warning">@Model.PendingApprovals</span>
            }
        </div>
        <div style="padding:16px 20px;">
            @if (Model.RecentLeaveRequests.Any())
            {
                @foreach (var leave in Model.RecentLeaveRequests.Take(3))
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f3f4f6;">
                        <div class="emp-avatar" style="background:#1a2942;width:32px;height:32px;font-size:11px;">
                            @string.Concat(leave.EmployeeName.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : ""))
                        </div>
                        <div style="flex:1;">
                            <div style="font-weight:600;font-size:13px;">@leave.EmployeeName</div>
                            <div style="font-size:12px;color:#6b7280;">
                                @leave.Type Leave · @leave.Days days
                            </div>
                        </div>
                        <div style="font-size:12px;color:#d97706;">
                            <i class="fa-solid fa-clock"></i> Pending
                        </div>
                    </div>
                }
                
                @if (Model.RecentLeaveRequests.Count > 3)
                {
                    <div style="text-align:center;margin-top:12px;">
                        <a href="/Supervisor/LeaveApproval" class="btn btn-outline btn-sm">
                            View All <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                }
            }
            else
            {
                <div style="text-align:center;padding:24px 0;color:#9ca3af;">
                    <i class="fa-regular fa-check-circle" style="font-size:32px;display:block;margin-bottom:8px;"></i>
                    <p style="font-size:13px;">No pending leave requests</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Attendance -->
    <div class="card">
        <div style="padding:16px 20px;border-bottom:1px solid var(--border);">
            <strong style="font-size:15px;">Recent Activity</strong>
        </div>
        <div style="padding:16px 20px;">
            @if (Model.RecentAttendance.Any())
            {
                @foreach (var record in Model.RecentAttendance.Take(3))
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f3f4f6;">
                        <div class="emp-avatar" style="background:#059669;width:32px;height:32px;font-size:11px;">
                            @string.Concat(record.EmployeeName.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : ""))
                        </div>
                        <div style="flex:1;">
                            <div style="font-weight:600;font-size:13px;">@record.EmployeeName</div>
                            <div style="font-size:12px;color:#6b7280;">
                                @record.Date.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <span class="badge @(record.Status == AttendanceStatus.Present ? "badge-success" : 
                                          record.Status == AttendanceStatus.Late ? "badge-warning" : 
                                          record.Status == AttendanceStatus.OnLeave ? "badge-muted" : "badge-danger")">
                            @record.Status
                        </span>
                    </div>
                }
            }
            else
            {
                <div style="text-align:center;padding:24px 0;color:#9ca3af;">
                    <i class="fa-regular fa-calendar" style="font-size:32px;display:block;margin-bottom:8px;"></i>
                    <p style="font-size:13px;">No recent activity</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Quick Stats Footer -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px;">
    <div class="stat-card" style="padding:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
                <div class="stat-label">Avg. Efficiency</div>
                <div class="stat-value" style="font-size:22px;">@Model.AvgEfficiency%</div>
            </div>
            <div class="stat-icon" style="background:#d1fae5;width:36px;height:36px;font-size:14px;">
                <i class="fa-solid fa-bullseye"></i>
            </div>
        </div>
    </div>
    <div class="stat-card" style="padding:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
                <div class="stat-label">Tasks Completed</div>
                <div class="stat-value" style="font-size:22px;">@Model.TotalTasksCompleted</div>
            </div>
            <div class="stat-icon" style="background:#d1fae5;width:36px;height:36px;font-size:14px;">
                <i class="fa-solid fa-check-double"></i>
            </div>
        </div>
    </div>
    <div class="stat-card" style="padding:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <div>
                <div class="stat-label">Total Hours Worked</div>
                <div class="stat-value" style="font-size:22px;">@Model.TotalHoursWorked</div>
            </div>
            <div class="stat-icon" style="background:#ede9fe;width:36px;height:36px;font-size:14px;">
                <i class="fa-solid fa-clock"></i>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Attendance Chart Data
        const attendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyAttendance.Select(w => new { 
            label = w.Day, 
            values = new[] { w.Present, w.Absent, w.Late } 
        })));
        drawBarChart('attendChart', attendData, ['#1a2942','#c0392b','#d4a847']);

        // Productivity Chart Data
        const prodData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductivityTrend));
        drawLineChart('prodChart', [
            { 
                values: prodData.map(d => d.target), 
                color: '#9ca3af', 
                dashed: true, 
                labels: prodData.map(d => d.week) 
            },
            { 
                values: prodData.map(d => d.actual), 
                color: '#1a2942', 
                dashed: false 
            }
        ]);
    </script>
}