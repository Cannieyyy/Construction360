@{
    ViewData["Title"] = "QR Scanner";
    ViewData["PageTitle"] = "QR Attendance Scanner";
    Layout = "_AppLayout";
}

<div class="page-header">
    <h1>QR Attendance Scanner</h1>
    <p>Scan employee QR codes to record attendance</p>
</div>

<div class="scanner-layout">
    <div class="card" style="padding:24px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
            <span style="font-size:20px;"><i class="fa-solid fa-camera"></i></span>
            <div>
                <strong>Camera Scanner</strong>
                <p class="text-sm text-muted">Point camera at employee QR code</p>
            </div>
        </div>
        <div class="scanner-preview" id="scannerPreview">
            <div class="scanner-corners"></div>
            <div style="font-size:64px;color:rgba(255,255,255,0.3);"><i class="fa-solid fa-qrcode"></i></div>
            <p style="color:rgba(255,255,255,0.5);font-size:13px;">Camera preview area</p>
            <p style="color:rgba(255,255,255,0.4);font-size:12px;">Click button below to simulate scan</p>
        </div>
        <div style="display:flex;gap:12px;margin-top:16px;">
            <button class="btn btn-primary w-full" onclick="simulateScan()"><i class="fa-solid fa-camera"></i> Simulate Scan</button>
            <button class="btn btn-outline btn-sm" onclick="startCamera()"><i class="fa-solid fa-video"></i> Start Camera</button>
        </div>
        <video id="cameraVideo" style="display:none;width:100%;border-radius:12px;margin-top:12px;" autoplay playsinline></video>
    </div>

    <div class="card" style="padding:20px;">
        <strong style="font-size:14px;">Recent Scans</strong>
        <p class="text-sm text-muted" style="margin-bottom:16px;">Today's attendance log</p>
        <div id="scanList">
            <div style="text-align:center;padding:40px 20px;color:#9ca3af;">
                <div style="font-size:32px;margin-bottom:8px;"><i class="fa-solid fa-user-clock"></i></div>
                <p style="font-size:13px;">No scans yet</p>
                <p style="font-size:12px;">Scanned employees will appear here</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const employees = [
            { name: 'Michael Chen', id: 'EMP-2023-001', dept: 'Manufacturing', initials: 'MC' },
            { name: 'Emily Rodriguez', id: 'EMP-2023-002', dept: 'Quality Control', initials: 'ER' },
            { name: 'David Thompson', id: 'EMP-2023-003', dept: 'Logistics', initials: 'DT' },
        ];
        let scans = [];

        function simulateScan() {
            const emp = employees[Math.floor(Math.random() * employees.length)];
            const time = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            scans.unshift({ ...emp, time });
            renderScans();
            document.getElementById('scannerPreview').style.borderColor = '#059669';
            setTimeout(() => document.getElementById('scannerPreview').style.borderColor = '', 800);
        }

        function renderScans() {
            const list = document.getElementById('scanList');
            if (!scans.length) return;
            list.innerHTML = scans.map(s => `
                <div style="display:flex;align-items:center;gap:10px;padding:10px;border-radius:8px;background:#f9fafb;margin-bottom:8px;border:1px solid #e5e7eb;">
                    <div class="emp-avatar" style="background:#1a2942;">${s.initials}</div>
                    <div style="flex:1;">
                        <div style="font-weight:700;font-size:13px;">${s.name}</div>
                        <div style="font-size:11.5px;color:#6b7280;">${s.id} · ${s.dept}</div>
                    </div>
                            <span style="font-size:12px;color:#059669;font-weight:600;display:flex;align-items:center;gap:5px;">
                                <i class="fa-regular fa-clock"></i>
                                ${s.time}
                            </span>
                </div>
            `).join('');
        }

        async function startCamera() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                const video = document.getElementById('cameraVideo');
                video.srcObject = stream;
                video.style.display = 'block';
            } catch(e) {
                alert('Camera access denied or not available.');
            }
        }
    </script>
}
