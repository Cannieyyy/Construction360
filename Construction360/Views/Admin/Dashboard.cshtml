@model Construction360.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard Overview";
    Layout = "_AppLayout";
}

<!-- SYSTEM OVERVIEW -->
<div class="stat-grid">

    <div class="stat-card">
        <div>
            <div class="stat-label">Total Accounts</div>
            <div class="stat-value">@Model.TotalAccounts</div>
            <div class="stat-sub">All registered users</div>
        </div>
        <div class="stat-icon">
            <i class="fa-solid fa-users"></i>
        </div>
    </div>

    <div class="stat-card">
        <div>
            <div class="stat-label">Active Accounts</div>
            <div class="stat-value">@Model.ActiveAccounts</div>
            <div class="stat-sub">Currently active</div>
        </div>
        <div class="stat-icon" style="background:#d1fae5;">
            <i class="fa-solid fa-user-check"></i>
        </div>
    </div>

    <div class="stat-card">
        <div>
            <div class="stat-label">Pending Accounts</div>
            <div class="stat-value">@Model.PendingAccounts</div>
            <div class="stat-sub">Awaiting approval</div>
        </div>
        <div class="stat-icon" style="background:#fef3c7;">
            <i class="fa-solid fa-user-clock"></i>
        </div>
    </div>

    <div class="stat-card">
        <div>
            <div class="stat-label">Inactive Accounts</div>
            <div class="stat-value">@Model.InactiveAccounts</div>
            <div class="stat-sub">Currently inactive</div>
        </div>
        <div class="stat-icon" style="background:#fee2e2;">
            <i class="fa-solid fa-user-slash"></i>
        </div>
    </div>

</div>


<!-- BUILDING OCCUPANCY -->
<div class="charts-row">

    <div class="chart-card">

        <h3>Building Occupancy</h3>

        <div style="display:flex;align-items:center;gap:24px;margin-top:20px;">

            <div style="
                width:120px;
                height:120px;
                border-radius:50%;
                background:#f0f4f8;
                display:flex;
                flex-direction:column;
                align-items:center;
                justify-content:center;
                flex-shrink:0;
            ">
                <div style="font-size:28px;font-weight:800;color:#1a2942;">
                    @Model.BuildingOccupancy
                </div>

                <div style="font-size:11px;color:#6b7280;">
                    Inside
                </div>
            </div>

            <div style="flex:1;">

                <div style="margin-bottom:16px;">
                    <div style="
                        display:flex;
                        justify-content:space-between;
                        margin-bottom:7px;
                        font-size:13px;
                    ">
                        <span>Employees Inside</span>
                        <strong>@Model.EmployeeCountInside</strong>
                    </div>

                    <div style="
                        height:8px;
                        background:#e5e7eb;
                        border-radius:8px;
                        overflow:hidden;
                    ">
                        <div style="
                            height:100%;
                            width:@(Model.BuildingOccupancy > 0
                                                             ? Math.Min(100, (Model.EmployeeCountInside * 100.0) / Model.BuildingOccupancy)
                                                             : 0)%;
                            background:#1a2942;
                            border-radius:8px;
                        "></div>
                    </div>
                </div>


                <div>
                    <div style="
                        display:flex;
                        justify-content:space-between;
                        margin-bottom:7px;
                        font-size:13px;
                    ">
                        <span>Supervisors Inside</span>
                        <strong>@Model.SupervisorCountInside</strong>
                    </div>

                    <div style="
                        height:8px;
                        background:#e5e7eb;
                        border-radius:8px;
                        overflow:hidden;
                    ">
                        <div style="
                            height:100%;
                            width:@(Model.BuildingOccupancy > 0
                                                             ? Math.Min(100, (Model.SupervisorCountInside * 100.0) / Model.BuildingOccupancy)
                                                             : 0)%;
                            background:#c0392b;
                            border-radius:8px;
                        "></div>
                    </div>
                </div>

            </div>

        </div>

        <div style="
            margin-top:20px;
            padding-top:16px;
            border-top:1px solid #e5e7eb;
            display:flex;
            justify-content:space-between;
            align-items:center;
        ">
            <span style="font-size:13px;color:#6b7280;">
                Current people inside building
            </span>

            <strong style="font-size:20px;color:#1a2942;">
                @Model.BuildingOccupancy
            </strong>
        </div>

    </div>


    <!-- SYSTEM STATUS -->
    <div class="chart-card">

        <h3>System Status</h3>

        <div style="
            display:flex;
            align-items:center;
            gap:14px;
            margin-top:24px;
            padding:18px;
            background:#f0fdf4;
            border:1px solid #bbf7d0;
            border-radius:8px;
        ">

            <div style="
                width:42px;
                height:42px;
                border-radius:50%;
                background:#d1fae5;
                display:flex;
                align-items:center;
                justify-content:center;
                color:#059669;
            ">
                <i class="fa-solid fa-check"></i>
            </div>

            <div>
                <div style="
                    font-size:14px;
                    font-weight:700;
                    color:#1a2942;
                ">
                    @Model.SystemStatus
                </div>

                <div style="
                    font-size:12px;
                    color:#6b7280;
                    margin-top:3px;
                ">
                    All core services are running
                </div>
            </div>

        </div>

        <div style="
            margin-top:18px;
            display:grid;
            gap:10px;
        ">

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:10px 0;
                border-bottom:1px solid #e5e7eb;
                font-size:13px;
            ">
                <span>Account System</span>
                <span class="badge badge-success">Operational</span>
            </div>

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:10px 0;
                border-bottom:1px solid #e5e7eb;
                font-size:13px;
            ">
                <span>QR Attendance System</span>
                <span class="badge badge-success">Operational</span>
            </div>

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                padding:10px 0;
                font-size:13px;
            ">
                <span>Notification System</span>
                <span class="badge badge-success">Operational</span>
            </div>

        </div>

    </div>

</div>





