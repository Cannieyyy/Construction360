@model Construction360.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard Overview";
    Layout = "_AppLayout";
}

<div class="stat-grid">
    <div class="stat-card">
        <div>
            <div class="stat-label">Total Employees</div>
            <div class="stat-value">@Model.TotalEmployees</div>
        </div>
        <div class="stat-icon">  <i class="fa-solid fa-users"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Present Today</div>
            <div class="stat-value">@Model.PresentToday</div>
        </div>
        <div class="stat-icon" style="background:#d1fae5;">  <i class="fa-solid fa-user-check"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Absent Today</div>
            <div class="stat-value">@Model.AbsentToday</div>
        </div>
        <div class="stat-icon" style="background:#fee2e2;"><i class="fa-solid fa-user-xmark"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Pending Leaves</div>
            <div class="stat-value">@Model.PendingLeaves</div>
        </div>
        <div class="stat-icon" style="background:#fef3c7;"><i class="fa-solid fa-file-circle-exclamation"></i></div>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div>
            <div class="stat-label">On Leave</div>
            <div class="stat-value">@Model.OnLeave</div>
        </div>
        <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
    </div>
    <div class="stat-card">
        <div>
            <div class="stat-label">Late Arrivals</div>
            <div class="stat-value">@Model.LateArrivals</div>
        </div>
        <div class="stat-icon" style="background:#fee2e2;"> <i class="fa-solid fa-triangle-exclamation"></i></div>
    </div>
    <div class="stat-card" style="grid-column: span 2;">
        <div>
            <div class="stat-label">Avg. Productivity</div>
            <div class="stat-value">@Model.AvgProductivity%</div>
        </div>
        <div class="stat-icon" style="background:#d1fae5;"><i class="fa-solid fa-chart-line"></i></div>
    </div>
</div>

<div class="charts-row">
    <div class="chart-card">
        <h3>Weekly Attendance</h3>
        <canvas id="weeklyChart" width="420" height="220"></canvas>
        <div style="display:flex;gap:16px;margin-top:12px;font-size:12px;">
            <span style="display:flex;align-items:center;gap:6px;"><span style="width:12px;height:12px;background:#1a2942;border-radius:3px;display:inline-block;"></span>Present</span>
            <span style="display:flex;align-items:center;gap:6px;"><span style="width:12px;height:12px;background:#c0392b;border-radius:3px;display:inline-block;"></span>Absent</span>
            <span style="display:flex;align-items:center;gap:6px;"><span style="width:12px;height:12px;background:#d4a847;border-radius:3px;display:inline-block;"></span>Late</span>
        </div>
    </div>
    <div class="chart-card">
        <h3>Department Distribution</h3>
        <div style="display:flex;align-items:center;gap:24px;">
            <canvas id="donutChart" width="200" height="200"></canvas>
            <div style="font-size:12.5px;flex:1;">
                @foreach (var dept in Model.DepartmentDistribution)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                        <span>@dept.Key</span>
                        <span style="font-weight:700;">@dept.Value%</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const weeklyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyAttendance.Select(w => new { label = w.Day, values = new[] { w.Present, w.Absent, w.Late } })));
        drawBarChart('weeklyChart', weeklyData, ['#1a2942','#c0392b','#d4a847']);

        const donutData = [
            { value: 44, color: '#1a2942' },
            { value: 15, color: '#c0392b' },
            { value: 22, color: '#6b7280' },
            { value: 9, color: '#d4a847' },
            { value: 10, color: '#059669' },
        ];
        drawDonut('donutChart', donutData);
    </script>
}
