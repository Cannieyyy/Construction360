@using Construction360.Models
@model List<Announcement>

@{
    ViewData["Title"] = "Announcements";
    ViewData["PageTitle"] = "Announcements";
    Layout = "_AppLayout";
}

<div class="page-header">
    <div>
        <h1>Announcements</h1>
        <p>Send important messages to employees and supervisors.</p>
    </div>
</div>

<div class="charts-row">

    <div class="chart-card">

        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
            <div class="stat-icon">
                <i class="fa-solid fa-bullhorn"></i>
            </div>

            <div>
                <h3 style="margin:0;">Create Announcement</h3>
                <p style="margin:4px 0 0;color:var(--text-muted);font-size:12px;">
                    Send a message to users across the system.
                </p>
            </div>
        </div>



        <form method="post" action="/Admin/SendAnnouncement">

            <div class="form-group">
                <label class="form-label">Announcement Title</label>

                <input type="text"
                       name="title"
                       class="form-control"
                       placeholder="Enter announcement title"
                       maxlength="100"
                       required />
            </div>

            <div class="form-group">
                <label class="form-label">Message</label>

                <textarea name="message"
                          class="form-control"
                          rows="6"
                          placeholder="Write your announcement..."
                          maxlength="1000"
                          required></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Send To</label>

                <select name="audience" class="form-control">
                    <option value="Everyone">Everyone</option>
                    <option value="Employees">Employees</option>
                    <option value="Supervisors">Supervisors</option>
                </select>
            </div>

            <div style="display:flex;justify-content:flex-end;margin-top:20px;">

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-paper-plane"></i>
                    Send Announcement
                </button>

            </div>

        </form>

    </div>

</div>


<div class="table-card">

    <div class="table-toolbar">

        <div>
            <h3 style="margin:0;">Previously Sent</h3>

            <span style="font-size:12px;color:var(--text-muted);">
                Announcement history
            </span>
        </div>

        <div style="font-size:13px;color:var(--text-muted);">
            @Model.Count announcement@(Model.Count == 1 ? "" : "s")
        </div>

    </div>

    <div style="overflow-x:auto;">

        <table class="data-table">

            <thead>
                <tr>
                    <th>Announcement</th>
                    <th>Audience</th>
                    <th>Sent By</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var announcement in Model)
                    {
                        <tr>

                            <td style="min-width:280px;">

                                <div style="font-weight:700;margin-bottom:4px;">
                                    @announcement.Title
                                </div>

                                <div style="font-size:12px;color:var(--text-muted);max-width:450px;">
                                    @announcement.Message
                                </div>

                            </td>

                            <td>

                                @if (announcement.Audience == "Everyone")
                                {
                                    <span class="badge badge-info">
                                        <i class="fa-solid fa-users"></i>
                                        Everyone
                                    </span>
                                }
                                else if (announcement.Audience == "Employees")
                                {
                                    <span class="badge badge-success">
                                        <i class="fa-solid fa-user"></i>
                                        Employees
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">
                                        <i class="fa-solid fa-user-tie"></i>
                                        Supervisors
                                    </span>
                                }

                            </td>

                            <td>
                                @announcement.SentBy
                            </td>

                            <td>
                                <div style="font-weight:600;">
                                    @announcement.SentDate.ToString("dd MMM yyyy")
                                </div>

                                <div style="font-size:12px;color:var(--text-muted);">
                                    @announcement.SentDate.ToString("HH:mm")
                                </div>
                            </td>

                            <td>
                                <span class="badge badge-success">
                                    <i class="fa-solid fa-check"></i>
                                    @announcement.Status
                                </span>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5"
                            style="text-align:center;padding:40px;color:var(--text-muted);">

                            <i class="fa-solid fa-bullhorn"
                               style="font-size:28px;margin-bottom:10px;"></i>

                            <div style="font-size:14px;font-weight:600;">
                                No announcements yet
                            </div>

                            <p style="font-size:13px;margin-top:5px;">
                                Announcements sent by administrators will appear here.
                            </p>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>