@using Construction360.Models
@model List<Notification>

@{
    ViewData["Title"] = "Notifications";
    ViewData["PageTitle"] = "Notifications";
    Layout = "_AppLayout";

    int unread = ViewBag.UnreadCount;
    string filter = ViewBag.Filter ?? "All";
}

<div class="page-header flex justify-between items-center">
    <div>
        <h1>Notifications</h1>
        <p>@unread unread notifications</p>
    </div>

    <div style="display:flex;gap:10px;">
        <form method="post" action="/Admin/MarkAllRead">
            <button class="btn btn-outline btn-sm" type="submit">
                <i class="fa-solid fa-check-double"></i>
                Mark All Read
            </button>
        </form>

        <button class="btn btn-primary btn-sm"
                type="button"
                onclick="location.href='/Admin/SendNotification'">
            <i class="fa-solid fa-paper-plane"></i>
            Send Notification
        </button>
    </div>
</div>

<div class="filter-tabs">

    <a href="/Admin/Notifications?filter=All"
       class="filter-tab @(filter == "All" ? "active" : "")">
        All
    </a>

    <a href="/Admin/Notifications?filter=Unread"
       class="filter-tab @(filter == "Unread" ? "active" : "")">
        Unread
    </a>

    <a href="/Admin/Notifications?filter=Info"
       class="filter-tab @(filter == "Info" ? "active" : "")">
        Info
    </a>

    <a href="/Admin/Notifications?filter=Success"
       class="filter-tab @(filter == "Success" ? "active" : "")">
        Success
    </a>

    <a href="/Admin/Notifications?filter=Warning"
       class="filter-tab @(filter == "Warning" ? "active" : "")">
        Warning
    </a>

    <a href="/Admin/Notifications?filter=Error"
       class="filter-tab @(filter == "Error" ? "active" : "")">
        Error
    </a>

</div>

@if (Model.Any())
{
    foreach (var n in Model)
    {
        var cardClass = n.IsRead
            ? ""
            : n.Type == "Warning"
                ? "warning"
                : n.Type == "Success"
                    ? "success"
                    : "unread";

        <div class="notif-card @cardClass">

            <div style="font-size:24px;line-height:1;">

                @if (n.Type == "Info")
                {
                    <i class="fa-solid fa-circle-info"></i>
                }
                else if (n.Type == "Warning")
                {
                    <i class="fa-solid fa-triangle-exclamation"></i>
                }
                else if (n.Type == "Success")
                {
                    <i class="fa-solid fa-circle-check"></i>
                }
                else
                {
                    <i class="fa-solid fa-circle-xmark"></i>
                }

            </div>

            <div style="flex:1;">

                <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                    <strong style="font-size:14px;">
                        @n.Title
                    </strong>

                    <span class="notif-date">
                        @n.Date.ToString("M/d/yyyy")
                    </span>
                </div>

                <p style="font-size:13px;color:#6b7280;">
                    @n.Message
                </p>

                <div style="display:flex;gap:14px;margin-top:6px;">

                    <form method="post"
                          action="/Admin/MarkNotificationRead"
                          style="display:inline;">

                        <input type="hidden" name="id" value="@n.Id" />

                        <button type="submit"
                                style="background:none;border:none;padding:0;font-size:13px;color:#2563eb;font-weight:600;cursor:pointer;">

                            <i class="fa-solid fa-eye"></i>
                            @(n.IsRead ? "View Details" : "Mark as Read")

                        </button>

                    </form>

                </div>

            </div>

            <form method="post"
                  action="/Admin/DeleteNotification">

                <input type="hidden" name="id" value="@n.Id" />

                <button type="submit"
                        style="background:none;border:none;cursor:pointer;color:#9ca3af;font-size:16px;"
                        title="Delete notification">

                    <i class="fa-solid fa-trash"></i>

                </button>

            </form>

        </div>
    }
}
else
{
    <div class="notif-card" style="justify-content:center;text-align:center;">
        <div style="width:100%;">

            <i class="fa-solid fa-bell-slash"
               style="font-size:28px;color:#9ca3af;margin-bottom:10px;"></i>

            <div style="font-size:14px;font-weight:600;">
                No notifications found
            </div>

            <p style="font-size:13px;color:#6b7280;margin-top:4px;">
                There are no notifications matching this filter.
            </p>

        </div>
    </div>
}