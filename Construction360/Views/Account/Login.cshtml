@model Construction360.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}
<div class="hero" style="min-height:100vh;">
    <nav class="navbar-public">
        <div style="display:flex;align-items:center;gap:10px;">
            <div class="brand-icon" style="background:#1a2942;">🏗</div>
            <span style="font-weight:800;font-size:16px;color:#1a2942;">Construct360</span>
            <span style="font-size:12px;color:#6b7280;margin-left:4px;">by ROCLA</span>
        </div>
        <div class="nav-links">
            <a href="#">Features</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </div>
        <div class="nav-ctas">
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Get Started</a>
        </div>
    </nav>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="brand-icon" style="background:#1a2942;">🏗</div>
            <span class="auth-brand-text">Construct360 <span>by ROCLA</span></span>
        </div>
        <h2 class="auth-title">Welcome back</h2>
        <p class="auth-subtitle">Sign in to your account to continue</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error-alert">@Model.Error</div>
        }

        <form method="post">
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <div class="input-wrap">
                        <span class="input-icon"><i class="fa-regular fa-envelope"></i></span>
                    <input name="Email" type="email" class="form-control" placeholder="role@rocla.com" value="@Model.Email" required />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Password</label>
                <div class="input-wrap">
                        <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input name="Password" id="pwdInput" type="password" class="form-control" placeholder="myP@55" required />
                        <button type="button" class="eye-toggle" onclick="togglePwd('pwdInput', this)"><i class="fa-regular fa-eye"></i></button>
                </div>
            </div>
            <div class="form-check">
                <label><input type="checkbox" name="RememberMe" /> Remember me</label>
                <a href="#" class="link">Forgot password?</a>
            </div>
            <button type="submit" class="btn btn-primary btn-full">Sign In →</button>
        </form>
        <div class="auth-footer">
            Don't have an account? <a href="/Account/Register" class="link">Create account</a>
        </div>
        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #e5e7eb;">
            <p style="font-size:12px;color:#9ca3af;text-align:center;margin-bottom:10px;">Demo credentials:</p>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:11.5px;">
                <div style="background:#f9fafb;padding:8px;border-radius:8px;border:1px solid #e5e7eb;">
                    <strong style="color:#1a2942;">Admin</strong><br>admin@rocla.com<br>admin123
                </div>
                <div style="background:#f9fafb;padding:8px;border-radius:8px;border:1px solid #e5e7eb;">
                    <strong style="color:#059669;">Supervisor</strong><br>supervisor@rocla.com<br>super123
                </div>
                
            </div>
        </div>
    </div>
</div>
</div>
<script>
    function togglePwd(id, btn) {
        const i = document.getElementById(id);
        i.type = i.type === 'password' ? 'text' : 'password';
        btn.textContent = i.type === 'password' ? '👁' : '🙈';
    }
</script>
