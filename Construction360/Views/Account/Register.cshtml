@model Construction360.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="auth-page" style="padding-top:60px;">
    <div class="auth-card" style="max-width:500px;">
        <h2 class="auth-title">Create your account</h2>
        <p class="auth-subtitle">Get started with Construct360 today</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error-alert">@Model.Error</div>
        }

        <form method="post">
            <div class="form-group">
                <label class="form-label">Full Name</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-regular fa-user"></i></span>
                    <input name="FullName" type="text" class="form-control" placeholder="Kopano Leshope" value="@Model.FullName" required />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Username</label>
                <div class="input-wrap">
                    <span class="input-icon">@@</span>
                    <input name="Username" type="text" class="form-control" placeholder="role@rocla.com" value="@Model.Username" required />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-regular fa-envelope"></i></span>
                    <input name="Email" type="email" class="form-control" placeholder="kopano@example.com" value="@Model.Email" required />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Password</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input name="Password" id="pwd1" type="password" class="form-control" placeholder="myP@55" required />
                    <button type="button" class="eye-toggle" onclick="togglePwd('pwd1',this)"><i class="fa-regular fa-eye"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Confirm Password</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input name="ConfirmPassword" id="pwd2" type="password" class="form-control" placeholder="Confirm your password" required />
                    <button type="button" class="eye-toggle" onclick="togglePwd('pwd2',this)"><i class="fa-regular fa-eye"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Select Your Role</label>

                <input type="hidden" name="Role" id="roleInput" value="Employee" />

                <div class="role-option selected"
                     data-role="Employee"
                     onclick="selectRole(this, 'Employee')">
                    <div class="role-option-left">
                        <div class="role-icon-wrap">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <div class="role-name">Employee</div>
                            <div class="role-desc">
                                Access personal attendance, leave requests, and QR code
                            </div>
                        </div>
                    </div>
                    <div class="radio-dot filled" id="dot-Employee"></div>
                </div>

                <div class="role-option"
                     data-role="Supervisor"
                     onclick="selectRole(this, 'Supervisor')">
                    <div class="role-option-left">
                        <div class="role-icon-wrap" style="background:#059669;">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                        <div>
                            <div class="role-name">Supervisor</div>
                            <div class="role-desc">
                                Manage team attendance, approve leaves, and scan QR codes
                            </div>
                        </div>
                    </div>
                    <div class="radio-dot" id="dot-Supervisor"></div>
                </div>

                <div class="role-option"
                     data-role="Admin"
                     onclick="selectRole(this, 'Admin')">
                    <div class="role-option-left">
                        <div class="role-icon-wrap" style="background:#7c3aed;">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <div class="role-name">Admin</div>
                            <div class="role-desc">
                                Full access to all system features and settings
                            </div>
                        </div>
                    </div>
                    <div class="radio-dot" id="dot-Admin"></div>
                </div>
            </div>

            <!-- Department -->
            <div class="form-group" id="departmentGroup">
                <label class="form-label" for="department">
                    Department
                </label>

                <div class="input-wrap">
                    <span class="input-icon">
                        <i class="fa-solid fa-building"></i>
                    </span>

                    <select name="Department"
                            id="department"
                            class="form-control department-select"
                            required>
                        <option value="">Select your department</option>
                        <option value="Construction">Construction</option>
                        <option value="Engineering">Engineering</option>
                        <option value="Finance">Finance</option>
                        <option value="Human Resources">Human Resources</option>
                        <option value="Information Technology">Information Technology</option>
                        <option value="Procurement">Procurement</option>
                        <option value="Projects">Projects</option>
                        <option value="Safety">Safety</option>
                        <option value="Operations">Operations</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Create Account</button>
        </form>
        <div class="auth-footer">Already have an account? <a href="/Account/Login" class="link">Sign in</a></div>
    </div>
</div>
<script>
    function togglePwd(id, btn) {
        const input = document.getElementById(id);

        input.type = input.type === 'password'
            ? 'text'
            : 'password';

        btn.innerHTML = input.type === 'password'
            ? '<i class="fa-regular fa-eye"></i>'
            : '<i class="fa-regular fa-eye-slash"></i>';
    }

    function selectRole(el, role) {
        // Remove selected state from all roles
        document.querySelectorAll('.role-option').forEach(option => {
            option.classList.remove('selected');
        });

        // Remove filled state from all radio buttons
        ['Employee', 'Supervisor', 'Admin'].forEach(r => {
            const dot = document.getElementById('dot-' + r);

            if (dot) {
                dot.classList.remove('filled');
            }
        });

        // Select current role
        el.classList.add('selected');

        const selectedDot = document.getElementById('dot-' + role);

        if (selectedDot) {
            selectedDot.classList.add('filled');
        }

        // Update hidden role field
        document.getElementById('roleInput').value = role;

        // Show/hide department
        updateDepartmentVisibility(role);
    }

    function updateDepartmentVisibility(role) {
        const departmentGroup = document.getElementById('departmentGroup');
        const department = document.getElementById('department');

        if (role === 'Admin') {
            // Admin covers all departments
            departmentGroup.style.display = 'none';

            // Prevent hidden department field from being required
            department.required = false;
            department.value = '';
        } else {
            // Employee and Supervisor must belong to a department
            departmentGroup.style.display = 'block';
            department.required = true;
        }
    }

    // Set correct state when the page loads
    document.addEventListener('DOMContentLoaded', function () {
        const currentRole =
            document.getElementById('roleInput').value || 'Employee';

        updateDepartmentVisibility(currentRole);
    });
</script>
